{
  "expo": {
    "name": "Pepmaxing",
    "slug": "pepmaxing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pepmaxing",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pepmaxing.app"
    },
    "android": {
      "package": "com.pepmaxing.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "ios": {
            "image": "./assets/images/splash-blank.png",
            "imageWidth": 1
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets us measure which campaigns bring people to Pepmaxing. Your protocols and health data stay on your device and are never sold."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
